CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Set per Convex deployment (NOT in this file for runtime):
#   Dev:  bunx convex env set NAME value
#   Prod: bunx convex env set NAME value --prod
#
# Required on BOTH deployments:
#   WORKOS_CLIENT_ID
#   WORKOS_API_KEY
#   WORKOS_WEBHOOK_SECRET
#   OPERATOR_EMAILS
#
# Staging WorkOS → Convex DEV (brainy-chinchilla-464)
#   webhook: https://brainy-chinchilla-464.eu-west-1.convex.site/workos/webhook
# Production WorkOS → Convex PROD (scintillating-cuttlefish-473)
#   webhook: https://scintillating-cuttlefish-473.convex.site/workos/webhook
#
# OPERATOR_EMAILS=hezaerd@hezaerd.com
#
# Cloudflare R2 (file storage):
#   R2_ACCOUNT_ID
#   R2_ACCESS_KEY_ID
#   R2_SECRET_ACCESS_KEY
#   R2_BUCKET_NAME
#
# CMS deploy token hashing (set on Convex deployment):
#   CMS_TOKEN_PEPPER=<random-string>
#
# CMS preview JWT (Portal → client site /preview):
#   CMS_PREVIEW_JWT_SECRET=<random-string>
#
# Public base URL for CMS asset keys (R2 custom domain or CDN):
#   CMS_ASSETS_PUBLIC_BASE_URL=https://cdn.example.com
