#
# OPERATOR_EMAILS=hezaerd@hezaerd.com
#
# Cloudflare R2 (file storage):
#   R2_ACCOUNT_ID
#   R2_ACCESS_KEY_ID
#   R2_SECRET_ACCESS_KEY
#   R2_BUCKET_NAME
#
# CMS deploy token hashing (set on Convex deployment):
#   CMS_TOKEN_PEPPER=<random-string>
#
# CMS preview JWT (Portal → client site /preview):
#   CMS_PREVIEW_JWT_SECRET=<random-string>  (openssl rand -base64 32)
#
# Public base URL for CMS assets + published snapshots (no trailing slash).
# Use the bucket's R2 public dev URL (Settings → Public Development URL) or a custom domain.
