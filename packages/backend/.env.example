# Set per Convex deployment (NOT in this file for runtime):
#   Dev:  bunx convex env set NAME value
#   Prod: bunx convex env set NAME value --prod
#
# Required on BOTH deployments:
#   WORKOS_CLIENT_ID
#   WORKOS_API_KEY
#   WORKOS_WEBHOOK_SECRET
#   OPERATOR_EMAILS
#
# Staging WorkOS → Convex DEV (brainy-chinchilla-464)
