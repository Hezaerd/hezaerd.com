{
  "$schema": "./node_modules/convex/schemas/convex.schema.json",
  "functions": "convex/",
  "aiFiles": {
    "enabled": false
  },
  "authKit": {
    "dev": {
      "configure": {
        "redirectUris": [
          "http://localhost:3002/api/auth/callback",
          "https://dev.portal.hezaerd.com/api/auth/callback"
        ],
        "appHomepageUrl": "http://localhost:3002",
        "corsOrigins": ["http://localhost:3002", "https://dev.portal.hezaerd.com"]
      },
      "localEnvVars": {
        "WORKOS_CLIENT_ID": "${authEnv.WORKOS_CLIENT_ID}",
        "WORKOS_API_KEY": "${authEnv.WORKOS_API_KEY}"
      }
    },
    "preview": {
      "configure": {
        "redirectUris": [
          "https://dev.portal.hezaerd.com/api/auth/callback",
          "https://${buildEnv.VERCEL_BRANCH_URL}/api/auth/callback"
        ],
        "appHomepageUrl": "https://dev.portal.hezaerd.com",
        "corsOrigins": [
          "https://dev.portal.hezaerd.com",
          "https://${buildEnv.VERCEL_BRANCH_URL}"
        ]
      }
    },
    "prod": {
      "environmentType": "production",
      "configure": {
        "redirectUris": ["https://portal.hezaerd.com/api/auth/callback"],
        "appHomepageUrl": "https://portal.hezaerd.com",
        "corsOrigins": ["https://portal.hezaerd.com"]
      }
    }
  }
}
