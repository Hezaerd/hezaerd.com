---
import { site } from "@/data/site";
import Base from "@/layouts/Base.astro";
---

<Base>
  <section id="top" class="relative isolate min-h-[max(640px,100svh)] overflow-hidden">
    <canvas id="light" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full opacity-0 transition-opacity duration-1000"></canvas>

    <div class="mx-auto flex min-h-[max(640px,100svh)] max-w-6xl flex-col justify-end px-5 pb-20 sm:px-8 md:pb-28">
      <div id="hero-text" class="w-fit max-w-xl">
        <h1 class="text-[clamp(3.5rem,11vw,8.5rem)] leading-[0.86] font-[640] tracking-[-0.045em] [font-stretch:110%]">
          {site.name}
        </h1>
        <p class="mt-6 text-lg text-foreground sm:text-xl">{site.role}, based in Martinique.</p>
        <p class="mt-3 max-w-md text-base leading-relaxed text-muted sm:text-lg">
          Jack of all trades, master of none, but oftentimes better than a master of one.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { mountFlock } from "@/scripts/flock";

  const canvas = document.getElementById("light") as HTMLCanvasElement;
  const ok = await mountFlock(canvas, {
    shape: "streak",
    centre: { wide: [0.68, 0.38], narrow: [0.5, 0.3] },
    cell: 1,
    size: 1.5,
    clear: document.getElementById("hero-text"),
  });
  if (ok) {
    requestAnimationFrame(() => canvas.classList.remove("opacity-0"));
  }
</script>
