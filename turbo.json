{
  "$schema": "https://turbo.build/schema.json",
  "noUpdateNotifier": true,
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".vercel/output/**", ".output/**", "dist/**"],
      "env": [
        "VITE_CONVEX_URL",
        "VITE_WORKOS_CLIENT_ID",
        "VITE_SITE_URL",
        "WORKOS_CLIENT_ID",
        "WORKOS_API_KEY",
        "WORKOS_COOKIE_PASSWORD",
        "WORKOS_REDIRECT_URI",
        "CONVEX_DEPLOY_KEY",
        "CONVEX_URL",
        "MARION_SERVICE_SECRET",
        "DISCORD_APPLICATION_ID",
        "DISCORD_BOT_TOKEN",
        "DISCORD_PUBLIC_KEY",
        "DISCORD_OPERATOR_USER_IDS",
        "MARION_CHAT_MODEL",
        "MARION_CHAT_MODEL_FALLBACK",
        "MARION_SUMMARIZE_MODEL",
        "MARION_EMBEDDING_MODEL"
      ],
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
