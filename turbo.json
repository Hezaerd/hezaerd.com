{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".vercel/output/**", ".output/**", "dist/**"],
      "env": [
        "VITE_CONVEX_URL",
        "VITE_WORKOS_CLIENT_ID",
        "VITE_SITE_URL",
        "WORKOS_CLIENT_ID",
        "WORKOS_API_KEY",
        "WORKOS_COOKIE_PASSWORD",
        "WORKOS_REDIRECT_URI",
        "CONVEX_DEPLOY_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
