# Local (.env.local) + Vercel Preview → Convex DEV + WorkOS Staging
# Vercel Production → Convex PROD + WorkOS Production
# (No Vercel Development env — local uses .env.local only.)
#
# Convex URLs:
#   DEV:  https://brainy-chinchilla-464.eu-west-1.convex.cloud
#   PROD: https://scintillating-cuttlefish-473.convex.cloud
#
# Sites:
#   local:   http://localhost:3002
#   preview: https://dev.portal.hezaerd.com
#   prod:    https://portal.hezaerd.com

VITE_CONVEX_URL=
VITE_WORKOS_CLIENT_ID=
VITE_SITE_URL=

WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3002/api/auth/callback

# WorkOS Dashboard → Redirects (source of truth; do not automate):
# https://dashboard.workos.com/redirects
#
# Staging:
#   Callback:          https://dev.portal.hezaerd.com/api/auth/callback
#   Sign-in endpoint:  https://dev.portal.hezaerd.com/api/auth/sign-in
#   App homepage:      https://dev.portal.hezaerd.com
#   + localhost callback for local: http://localhost:3002/api/auth/callback
#
# Production:
#   Callback:          https://portal.hezaerd.com/api/auth/callback
#   Sign-in endpoint:  https://portal.hezaerd.com/api/auth/sign-in
#   App homepage:      https://portal.hezaerd.com
#
# Also: Authentication → Sessions → CORS → same origins.

# Vercel Production only (auto-deploys Convex prod during portal Production builds):
# CONVEX_DEPLOY_KEY=
#
# Never put WORKOS_WEBHOOK_SECRET on Vercel — that lives on Convex only.
# Preview builds share Convex DEV; no Convex preview deploy key.
